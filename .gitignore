# macOS
.DS_Store
._*

# Python
__pycache__/
*.pyc
*.pyo
.env
*.egg-info/
.eggs/
build/
dist/

# Inputs. The cohorts are all access-controlled (MIMIC-IV, EHRSHOT, eICU-CRD,
# INSPIRE, CHS), so no data of any kind is committed; scripts/process/ rebuilds
# data/processed/ from the raw sources.
/data/
cache/
*.pkl

# Training artifacts: 28 GB of checkpoints and 5 GB of W&B traces. The published
# checkpoint is distributed through Hugging Face (app/app.py HF_REPO) instead.
model/logs/
model/predictions/
model/wandb/
wandb/
*.log
scripts/jobs/logs/
model/jobs/logs/

# What the pipeline computes. The published figures, the tables behind them and
# the per-cohort result CSVs are committed, so a reader gets every figure in the
# paper without access to the cohorts (~104 MB, aggregate statistics only -- no
# row is per-patient and no file carries a patient identifier).
#
# results/raw/ is not: 4.6 GB of per-prediction tables, regenerated by
# scripts/02_index_labs.py .. 17_outcomes.py from the access-controlled cohorts.
/results/raw/

# Manuscript and peer-review material -- NEVER publish to the public repo.
submission/
nature-2026-submission/
SHAH_NORMA_MANUSCRIPT_2026/
manuscript/
scratch/
scratch*/
_archive/
*.docx
*.doc
# Nature reporting/software checklists and any filled response forms
nr-*.pdf
*reporting-summary*.pdf
*software-policy*.pdf

